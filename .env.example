# Neon / Postgres connection string (server only)
DATABASE_URL=

# better-auth signing secret. Generate with: npx -y @better-auth/cli secret
BETTER_AUTH_SECRET=

# Public origin of this app. Local: http://localhost:3000
# Production: your workers.dev or custom domain, with no trailing slash
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated user IDs that skip workspace, member, and upload quotas
QUOTA_EXEMPT_USER_IDS=

# Resend (optional locally). Without a key, signup still works but emails are skipped.
RESEND_API_KEY=
# Verified sender, e.g. Task <noreply@yourdomain.com>
EMAIL_FROM=
